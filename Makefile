.PHONY: help git-status git-commit git-push

# ============================================================
# dotfiles — Makefile
# ============================================================

# 默认目标
help:
	@echo "dotfiles — 可用目标:"
	@echo ""
	@echo "  make git-status          查看仓库状态"
	@echo "  make git-commit MSG=...  暂存所有更改并提交"
	@echo "  make git-push            推送至远程仓库"

# ------------------------------------------------------------
# 查看仓库状态
# ------------------------------------------------------------
git-status:
	@git status

# ------------------------------------------------------------
# 提交更改
# 用法: make git-commit MSG="你的提交信息"
# ------------------------------------------------------------
git-commit:
	@if [ -z "$(MSG)" ]; then \
		echo "错误: 请指定提交信息"; \
		echo "用法: make git-commit MSG=\"描述这次更改\""; \
		exit 1; \
	fi
	@echo ">>> 当前变更:"
	@git status --short
	@echo ""
	@echo ">>> 暂存所有变更..."
	@git add -A
	@echo ">>> 提交..."
	@git commit -m "$(MSG)"
	@echo ">>> 提交完成 ✓"

# ------------------------------------------------------------
# 推送至远程仓库
# ------------------------------------------------------------
git-push:
	@echo ">>> 推送..."
	@git push
	@echo ">>> 推送完成 ✓"
